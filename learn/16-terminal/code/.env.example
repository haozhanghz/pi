# 复制这个文件为 .env，填上你自己的配置。.env 已经在 .gitignore 里，不会被提交。
# 运行程序时加上 --env-file=.env，例如：node --env-file=.env playground/ai-chat.ts

# 默认使用哪个模型（服务商/模型名）。不设置时使用课程的假模型服务器 fake/fake-model。
# MINI_PI_MODEL=deepseek/deepseek-chat

# 各家服务商的 API key：只需要填你用到的那一家
# DEEPSEEK_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...
# ZHIPU_API_KEY=...
# SILICONFLOW_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# 自定义的 OpenAI 兼容服务（使用 --model custom/模型名 时生效）
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=...
