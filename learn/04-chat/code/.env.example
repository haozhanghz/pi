# 复制这个文件为 .env，然后填上你自己的配置。.env 已经在 .gitignore 里，不会被提交。
# 运行程序时加上 --env-file=.env，例如：node --env-file=.env playground/ask.ts "你好"

# 使用假模型服务器（先运行 node <课程目录>/learn/tools/fake-llm/server.ts）
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=fake
LLM_MODEL=fake-model

# 使用 DeepSeek（把上面三行注释掉，再取消下面三行的注释）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-chat
